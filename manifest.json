{
    "manifest_version": 2,
    "id": "plantonistas",
    "name": "Plantonistas",
    "version": "4.0.0",
    "author": "Rafael M. A. Leão Ereno - MALE - unificação de module-zbx-escala-plantao (fork de pandradee/zabbix-escala-de-plantao) e module-zbx-repasse-plantao (fork de JohnnyIver/zabbix-report-module)",
    "url": "https://github.com/leaoereno/module-zbx-plantonistas",
    "description": "Gestão completa de plantonistas: escala mensal por grupo de usuários, telefones, histórico, relatório de repasse de plantão NOC e turnos configuráveis por equipe. Unifica os antigos módulos Escala de Plantão e Relatório Repasse de Plantão.",
    "namespace": "Plantonistas",
    "actions": {
        "plantonistas.overview": {
            "class": "PlantaoOverview",
            "view": "plantonistas.overview"
        },
        "plantonistas.list": {
            "class": "PlantaoList",
            "view": "plantonistas.list"
        },
        "plantonistas.save": {
            "class": "PlantaoSave"
        },
        "plantonistas.delete": {
            "class": "PlantaoDelete"
        },
        "plantonistas.history": {
            "class": "PlantaoHistory",
            "view": "plantonistas.history"
        },
        "plantonistas.export": {
            "class": "PlantaoExport"
        },
        "plantonistas.import": {
            "class": "PlantaoImport"
        },
        "plantonistas.phones.list": {
            "class": "PhonesList",
            "view": "plantonistas.phones.list"
        },
        "plantonistas.phones.export": {
            "class": "PhonesExport"
        },
        "plantonistas.phones.save": {
            "class": "PhonesSave"
        },
        "plantonistas.report.view": {
            "class": "TurnosReportView",
            "view": "plantonistas.report.view"
        },
        "plantonistas.report.notes.save": {
            "class": "TurnosNotesSave",
            "layout": "layout.javascript",
            "view": null
        },
        "plantonistas.report.notes.get": {
            "class": "TurnosNotesGet",
            "layout": "layout.javascript",
            "view": null
        },
        "plantonistas.report.pdf": {
            "class": "TurnosReportPdf",
            "view": "plantonistas.report.view"
        },
        "plantonistas.shifts.view": {
            "class": "TurnosShiftsView",
            "view": "plantonistas.shifts.view"
        },
        "plantonistas.shifts.save": {
            "class": "TurnosShiftsSave",
            "layout": "layout.javascript",
            "view": null
        },
        "plantonistas.shifts.delete": {
            "class": "TurnosShiftsDelete",
            "layout": "layout.javascript",
            "view": null
        },
        "plantonistas.usershift.save": {
            "class": "TurnosUserShiftSave",
            "layout": "layout.javascript",
            "view": null
        }
    },
    "assets": {
        "css": [
            "turnos.report.css"
        ],
        "js": [
            "class.turnos.report.js"
        ]
    }
}
